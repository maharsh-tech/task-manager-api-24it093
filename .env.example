MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?appName=Cluster0
PORT=5000
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=your-long-random-secret-here
JWT_EXPIRES_IN=1h
# Practical 13 AI Integration (OpenAI or OpenAI-compatible like OpenRouter)
OPENAI_API_KEY=your_openai_or_openrouter_api_key_here
OPENAI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=meta-llama/llama-3.1-8b-instruct:free
